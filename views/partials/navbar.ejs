<nav class="navbar">
  <div class="logo">
    <img src="/images/beebalancedlogo.jpg" alt="Bee Logo" class="bee-icon">
    Bee Balanced
  </div>
  <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button>
  <div class="nav-links">
    <a href="/home">Home</a>
    <a href="/chatbot">Chatbot</a>
    <a href="/survey">Survey</a>
    <div class="dropdown">
    <button class="dropbtn" type="button">Progress ▾</button>
      <div class="dropdown-content">
        <a href="/chart">Weekly Progress</a>
        <a href="/calendar">Monthly Progress</a>
        <a href="/feedback">Recent Feedback</a>
      </div>
    </div>  
    <a href="/games">Games</a>
    <a href="/edit-account">Account</a>
    <a href="/logout">Logout</a>
    <% if (user && user.is_admin) { %>
      <a href="/admin/data-analysis">Admin Data</a>
    <% } %>
  </div>
</nav>

 
 <style>
 /* Navigation Bar Styles */
 .navbar {
   display: flex;
   align-items: center;
   justify-content: space-between;
   background-color: #222;
   padding: 15px 20px;
 }
 .navbar .logo {
   display: flex;
   align-items: center;
   font-size: 24px;
   font-weight: bold;
   color: #ffd700; /* Gold color */
 }
 .navbar .bee-icon {
   width: 60px;  /* Adjust size */
   height: 60px;
   margin-right: 10px;
 }
 .navbar .nav-links {
   display: flex;
   gap: 20px;
 }
 .navbar a {
   color: white;
   text-decoration: none;
   font-size: 18px;
   padding: 10px 15px;
   transition: background 0.3s ease, color 0.3s ease;
 }
 .navbar a:hover {
   background-color: #444;
   border-radius: 5px;
   color: #ffd700;
 }

 /* Dropdown Container */
.dropdown {
  position: relative;
  display: center;
}

/* Dropdown Button */
.dropbtn {
  color: white;
  text-decoration: none;
  font-size: 18px;
  padding: 10px 15px;
  transition: background 0.3s ease, color 0.3s ease;
  background: none;
  border: none;
  cursor: pointer;
  font-family: inherit;
  display: inline-block;
  line-height: 1.2;
}

/* Dropdown Content */
.dropdown-content {
  display: none;
  position: absolute;
  background-color: #333;
  min-width: 180px;
  box-shadow: 0px 8px 16px rgba(0,0,0,0.2);
  z-index: 1;
  border-radius: 5px;
}

.dropdown-content a {
  color: white;
  padding: 12px 16px;
  text-decoration: none;
  display: block;
}

.dropdown-content a:hover {
  background-color: #444;
  color: #ffd700;
}

.dropdown:hover .dropdown-content {
  display: block;
}

.dropdown:hover .dropbtn {
  background-color: #444;
  border-radius: 5px;
  color: #ffd700;
}
/* Mobile CSS */
.menu-toggle {
  display: none;            /* hidden on desktop */
  background: none;
  border: none;
  color: white;
  font-size: 28px;
  cursor: pointer;
}

/* Tap-to-open */
.dropdown.open .dropdown-content {
  display: block;
}

@media (max-width: 768px) {
  .navbar {
    flex-wrap: wrap;          /* lets links drop to a new row */
    padding: 10px 16px;
  }
  .navbar .logo { font-size: 20px; }
  .navbar .bee-icon { width: 40px; height: 40px; }

  .menu-toggle { display: block; }

  .navbar .nav-links {
    display: none;            /* hidden until ☰ is tapped */
    flex-direction: column;
    width: 100%;
    gap: 0;
    margin-top: 10px;
  }
  .navbar.open .nav-links { display: flex; }

  .navbar .nav-links a,
  .navbar .dropbtn {
    display: block;
    width: 100%;
    text-align: left;
    padding: 14px 10px;       /* big tap targets */
    box-sizing: border-box;
  }

  /* On phones the submenu sits in the list instead of floating */
  .dropdown-content {
    position: static;
    box-shadow: none;
    padding-left: 15px;
  }

  /* Turn off hover-opening on phones so it doesn't get stuck */
  .dropdown:hover .dropdown-content { display: none; }
  .dropdown.open .dropdown-content { display: block; }
}

 </style>
/* Script for taps */
 <script>
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('.navbar');
    const toggle = nav.querySelector('.menu-toggle');
    const dropdown = nav.querySelector('.dropdown');
    const dropbtn = nav.querySelector('.dropbtn');

    // ☰ opens/closes the whole menu
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', isOpen);
    });

    // "Progress" opens/closes its submenu
    dropbtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('open');
    });

    // Tapping anywhere else closes the submenu
    document.addEventListener('click', () => dropdown.classList.remove('open'));
  });
</script>

